ll find_pivot(ll min, ll max) {
  std::random_device rd;
  std::mt19937 gen(rd());
  std::uniform_int_distribution<> distrib(min, max);
  ll ret = distrib(gen);
  return ret;
}

void swap(ll i, ll j) {
  ll a = start_times[i];
  ll b = start_times[j];
  start_times[i] = b;
  start_times[j] = a;

  ll c = end_times[i];
  ll d = end_times[j];
  end_times[i] = d;
  end_times[j] = c;
}


ll partition(ll start, ll end) {
  ll pivot_index = find_pivot(start, end);
  ll pivot_value = start_times[pivot_index];
