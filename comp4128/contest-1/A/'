  cout << endl;
    while (l <= r && start_times[l] <= pivot_value) { l++; }
    while (l <= r && start_times[r] >= pivot_value) { r--; }
    swap(l, r);
    if (l > r) {
      break;
    }
  }
  swap(r, pivot_index);
  return r;
}

void qsort_startend(ll start, ll end) {
  if (end <= start) return;

  ll pivot_index = partition(start, end);
  qsort_startend(start, pivot_index - 1);
  qsort_startend(pivot_index, end);
}

